{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "outDir": "./js",
    "rootDir": "./src",
    "strict": true,
    "strictNullChecks": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*"]
}
